# Non-secret defaults verified against the academy-lab profile in us-east-1 on 2026-09-10.
AWS_PROFILE=academy-lab
AWS_REGION=us-east-1
STACK_NAME=airline-demo
AMI_ID=ami-0b5358cc8c5df0b02
KEY_NAME=airline-demo-key
INSTANCE_TYPE=t3.micro
DB_INSTANCE_CLASS=db.t3.micro
DB_ENGINE_VERSION=16.10
DB_NAME=airline_oltp
DB_USER=airline_admin
ANALYTICS_DB_NAME=airline_analytics
ANALYTICS_DB_INSTANCE_CLASS=db.t3.micro
# Existing role supplied by AWS Academy; replace 123456789012 with the lab account ID.
GLUE_ROLE_ARN=arn:aws:iam::123456789012:role/LabRole
